    },
    "Use these controls for score changes, side clocks, team fouls, substitutions, pauses, and sport-specific actions." : {
      "comment" : "A description of the score controls on the scoreboard.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用这些控制项调整比分、双方计时、全队犯规、换人、暂停和项目专属操作。"
          }
        }
      }
    },
    "Use This Device as Remote Display" : {
      "extractionState" : "stale",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将此设备用作远程显示"
          }
        }
      }
    },
    "Use this when another Apple device should show the public scoreboard while the operator keeps private controls on the main device." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当另一台 Apple 设备需要显示公开记分牌，而操作员仍在主设备上保留私有控制时使用。"
          }
        }
      }
    },
    "Use this when local overlays, browser sources, or scripts need a read-only stream of live scoreboard state from the operator device." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当本地叠层、浏览器源或脚本需要从操作设备读取实时记分牌状态的只读数据流时使用。"
          }
        }
      }
    },
    "Use this when scoreboard moments should press Companion buttons for graphics, scene changes, lighting, or other production automation." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当记分牌事件需要触发 Companion 按钮，以控制图形、场景切换、灯光或其他制作自动化时使用。"
          }
        }
      }
    },
    "Use Web API when local overlays, browser sources, custom dashboards, or production scripts need to read live scoreboard state. The API is read-only for game operations and publishes current state over HTTP and WebSocket ports." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当本地叠层、浏览器源、自定义仪表板或制作脚本需要读取实时记分牌状态时，使用 Web API。该 API 对比赛操作只读，并通过 HTTP 和 WebSocket 端口发布当前状态。"
          }
        }
      }
    },
